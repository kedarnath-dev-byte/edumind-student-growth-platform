ENVIRONMENT=production
DEBUG=false
PORT=8000

# Required for real AI responses.
GROQ_API_KEY=replace-with-your-groq-api-key
GROQ_MODEL=llama3-8b-8192

# Keep this secret in production.
SECRET_KEY=replace-with-a-long-random-secret

# Local/default database. Do not commit real database passwords.
DATABASE_URL=sqlite:///./edumind.db
# DATABASE_URL=postgresql+psycopg2://postgres:<password>@<host>:5432/postgres

# Local persistent folders.
CHROMA_PERSIST_DIR=./data/vectorstore
UPLOAD_DIR=./data/uploads
MAX_FILE_SIZE_MB=50

# Optional Google OAuth settings.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/callback

# --- Google Drive student uploads (set on Render; never commit real SA JSON) ---
GOOGLE_DRIVE_ENABLED=false
# Prefer OAuth (personal Gmail quota). Required when not using a Shared Drive + SA.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
GOOGLE_SERVICE_ACCOUNT_JSON=
DRIVE_UPLOADS_ROOT_ID=
DRIVE_PROOFS_FOLDER_ID=
DRIVE_DOCUMENTS_FOLDER_ID=

