DATABASE_URL=sqlite:///./edumind.db
# DATABASE_URL=postgresql+psycopg2://postgres:<password>@<host>:5432/postgres

# Do not commit real database passwords or production secrets.

# Google Drive student uploads (backend only)
GOOGLE_DRIVE_ENABLED=false
# Prefer OAuth (personal Gmail quota). Required when not using a Shared Drive + SA.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
GOOGLE_SERVICE_ACCOUNT_JSON=
DRIVE_UPLOADS_ROOT_ID=
DRIVE_PROOFS_FOLDER_ID=
DRIVE_DOCUMENTS_FOLDER_ID=

# --- Mux Shorts video (preferred for live feed; Drive is archive-only) ---
# Create tokens at https://dashboard.mux.com/settings/access-tokens
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
# Optional: restrict direct-upload CORS (default *)
MUX_CORS_ORIGIN=*
# Optional: webhook signing secret (webhook processing deferred)
MUX_WEBHOOK_SECRET=

# --- WhatsApp revision reminders (see docs/WHATSAPP_REVISION_REMINDERS.md) ---
# Provider: meta (Meta Cloud API, default) | gupshup
WHATSAPP_PROVIDER=meta
WHATSAPP_ENABLED=false
WHATSAPP_DRY_RUN=true
# Meta Cloud API
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0
WHATSAPP_TEMPLATE_REVISION_PLAN=edumind_revision_plan
WHATSAPP_TEMPLATE_MORNING_DIGEST=edumind_morning_revisions
# Gupshup (set WHATSAPP_PROVIDER=gupshup; no Meta phone number ID required)
GUPSHUP_API_KEY=
GUPSHUP_APP_NAME=
GUPSHUP_SOURCE_PHONE=
GUPSHUP_TEMPLATE_REVISION_PLAN=
GUPSHUP_TEMPLATE_MORNING_DIGEST=
INTERNAL_JOB_SECRET=
